# Copy to .env and fill in. .env is ignored by git; never commit it.
#
#   cp .env.example .env

# Required: the password of the `goliath` ClickHouse account, which compose
# creates. Generate one, for example: openssl rand -base64 24
CLICKHOUSE_PASSWORD=

# Required: the token the interface and every API request must present, at
# least 32 bytes. Generate one, for example: openssl rand -hex 32
API_TOKEN=
